# AssignFlow environment template - PLACEHOLDERS ONLY. Never commit a real .env.
# Setup (PowerShell):  Copy-Item .env.example .env   then replace every "change-me" / CHANGE_ME value.
# Credentials in DATABASE_URL and S3_* must match POSTGRES_* and MINIO_ROOT_* below.

# --- PostgreSQL (service: postgres) ---
POSTGRES_USER=assignflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assignflow
# Hostname is the Compose service name, never localhost. Password must equal POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://assignflow:change-me@postgres:5432/assignflow

# --- Redis (service: redis) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (service: minio) ---
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-min-8-chars
S3_ENDPOINT_URL=http://minio:9000
# Used by the initializer to create the private bucket. For now keep these equal to
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-min-8-chars
S3_BUCKET=assignflow-submissions
S3_REGION=us-east-1

# --- Demo seeding (Phase 2) ---
# REQUIRED: the single demo-only password given to all 250 seeded accounts. No default exists; initialization
# fails if empty. Choose your own value; never commit it.
SEED_DEMO_PASSWORD=change-me-demo-password

# --- Authentication (Phase 3) ---
# REQUIRED: at least 32 random characters; the API refuses to start otherwise.
# Generate locally:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_locally
JWT_EXPIRE_MINUTES=120

# --- Reserved for later phases (declared, not used yet) ---
MAX_UPLOAD_MB=10
APP_TIMEZONE_DISPLAY=Asia/Kolkata

# --- Browser-facing ---
# CORS origin the backend accepts. Must exactly match the URL you open the frontend at.
FRONTEND_ORIGIN=http://localhost:5173
# PUBLIC build-time value embedded in the frontend bundle (no secrets!). Must be host-reachable
# (localhost), never http://backend:8000. Changing it requires: docker compose up --build -d frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
